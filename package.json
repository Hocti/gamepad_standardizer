{
	"name": "gamepad_standardizer",
	"version": "1.0.4",
	"main": "./dist/gamepad_standardizer.cjs.js",
	"module": "./dist/gamepad_standardizer.esm.js",
	"bundle": "./dist/gamepad_standardizer.js",
	"types": "./dist/gamepad_standardizer.d.ts",
	"namespace": "gamepad_standardizer",
	"exports": {
		".": {
			"import": {
				"types": "./dist/gamepad_standardizer.d.ts",
				"default": "./dist/gamepad_standardizer.esm.js"
			},
			"require": {
				"types": "./dist/gamepad_standardizer.d.ts",
				"default": "./dist/gamepad_standardizer.cjs.js"
			}
		}
	},
	"scripts": {
		"watch": "rollup -c --watch",
		"build": "cross-env NODE_ENV=production rollup -c"
	},
	"author": "hocti",
	"license": "MIT",
	"keywords": [
		"gamepad",
		"joystick",
		"gamepadapi"
	],
	"homepage": "https://github.com/Hocti/gamepad_standardizer",
	"repository": {
		"type": "git",
		"url": "https://github.com/Hocti/gamepad_standardizer"
	},
	"readme": "README.md",
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.6",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@types/node": "^24.0.10",
		"cross-env": "^7.0.3",
		"esbuild": "^0.25.5",
		"rollup": "^4.44.1",
		"rollup-plugin-dts": "^6.2.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"typescript": "^5.8.3"
	}
}