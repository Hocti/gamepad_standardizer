{
  "name": "gamepad_standardizer",
  "version": "2.0.1",
  "description": "Standardises gamepad input into a normalised format.",
  "type": "module",
  "license": "MIT",
  "author": "Hocti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hocti/gamepad_standardizer.git"
  },
  "main": "./dist/gamepadStandardizer.mjs",
  "module": "./dist/gamepadStandardizer.mjs",
  "types": "./dist/gamepadStandardizer.d.ts",
  "unpkg": "./dist/gamepadStandardizer.js",
  "jsdelivr": "./dist/gamepadStandardizer.js",
  "exports": {
    ".": {
      "types": "./dist/gamepadStandardizer.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/gamepadStandardizer.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "readme": "README.md",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:db": "tsx scripts/build-db.mts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "gamepad_fonts": "workspace:^"
  },
  "devDependencies": {
    "@mono/configs": "workspace:*",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-basic-ssl": "latest",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vitest": "^4.1.10"
  }
}